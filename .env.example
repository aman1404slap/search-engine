# Copy to .env and adjust as needed. AWS credentials themselves are NOT set
# here -- export the temporary AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN in the same terminal you run `manage.py runserver` /
# `celery -A config worker` from; boto3 picks them up automatically.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me

# Postgres (matches the `db` service in docker-compose.dev.yml)
POSTGRES_DB=video_search
POSTGRES_USER=video_search
POSTGRES_PASSWORD=video_search
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superadmin bootstrap -- re-applied (idempotent) on every container start.
# Log into /admin with these to create further user accounts.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me

# Dev SPA runs on a different port than Django -- both need to be listed here.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

AWS_S3_REGION=us-east-2
AWS_S3_DEFAULT_BUCKET=ssai-staging-us-east-2
S3_SOURCE_LOCAL_MOUNT_PREFIX=/mnt/experiments/
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SEARCH_DENSE_WEIGHT=0.6
SEARCH_KEYWORD_WEIGHT=0.4
SEARCH_SPAN_MERGE_GAP_SECONDS=2.0
SEARCH_DECOMPOSE_QUERY=true
SEARCH_RERANK_ENABLED=true
SEARCH_RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
SEARCH_RERANK_TOP_N=10

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
