# Copy to `.env` ON THE EC2 HOST (in the same directory as
# docker-compose.prod.yml) and fill in real values. This file is never
# built into an image or passed through CircleCI -- it's created once by
# hand as part of the one-time EC2 setup (see README's Deployment section)
# and stays on the host across deploys.

DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-value

# Postgres -- deliberately has NO persistent volume in docker-compose.prod.yml,
# so these values only need to be internally consistent; the DB is wiped
# fresh on every deploy.
POSTGRES_DB=video_search
POSTGRES_USER=video_search
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Superadmin bootstrap -- re-applied (idempotent) on every deploy. Log into
# /admin with these to create further user accounts.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=replace-with-a-strong-password

# Set to the domain/IP the site is actually served from.
CSRF_TRUSTED_ORIGINS=http://your-ec2-public-ip-or-domain

REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=false

# S3 video source -- prefer an IAM instance role on the EC2 box over static
# keys here if convenient; boto3 picks either up automatically.
AWS_S3_REGION=us-east-2
AWS_S3_DEFAULT_BUCKET=ssai-staging-us-east-2
S3_SOURCE_LOCAL_MOUNT_PREFIX=/mnt/experiments/
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SEARCH_DENSE_WEIGHT=0.6
SEARCH_KEYWORD_WEIGHT=0.4
SEARCH_SPAN_MERGE_GAP_SECONDS=2.0
SEARCH_DECOMPOSE_QUERY=true
SEARCH_RERANK_ENABLED=true
SEARCH_RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
SEARCH_RERANK_TOP_N=10

# CORS_ALLOWED_ORIGINS isn't needed in prod -- nginx serves the frontend and
# proxies /api same-origin, so the browser never makes a cross-origin call.
