# Copy to .env and adjust as needed. AWS credentials themselves are NOT set
# here -- export the temporary AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_SESSION_TOKEN in the same terminal you run `manage.py runserver` /
# `celery -A config worker` from; boto3 picks them up automatically.

DJANGO_DEBUG=true
DJANGO_SECRET_KEY=change-me

REDIS_URL=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=false

AWS_S3_REGION=us-east-2
AWS_S3_DEFAULT_BUCKET=ssai-staging-us-east-2
S3_SOURCE_LOCAL_MOUNT_PREFIX=/mnt/experiments/
S3_PRESIGNED_URL_EXPIRY_SECONDS=3600

EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIM=384
SEARCH_DENSE_WEIGHT=0.6
SEARCH_KEYWORD_WEIGHT=0.4
SEARCH_SPAN_MERGE_GAP_SECONDS=2.0
SEARCH_DECOMPOSE_QUERY=true
SEARCH_RERANK_ENABLED=true
SEARCH_RERANK_MODEL_NAME=cross-encoder/ms-marco-MiniLM-L-6-v2
SEARCH_RERANK_TOP_N=10

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
